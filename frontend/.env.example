# Expo reads variables prefixed with EXPO_PUBLIC_.
# Android emulator uses 10.0.2.2 to reach the host machine.
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:5000
EXPO_PUBLIC_API_URL_IOS=http://localhost:5000
EXPO_PUBLIC_API_URL_WEB=http://localhost:5000

# For a physical phone on the same Wi-Fi, replace localhost with your computer IP.
# Example:
# EXPO_PUBLIC_API_URL=http://192.168.1.25:5000
