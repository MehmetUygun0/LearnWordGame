# ASP.NET Core backend example environment variables

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5184;https://localhost:7047

# SQL Server connection string
ConnectionStrings__DefaultConnection=Server=localhost;Database=Project;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# Future auth settings
JWT__Issuer=LearnWordGame
JWT__Audience=LearnWordGameClient
JWT__Secret=replace_with_a_long_random_secret
